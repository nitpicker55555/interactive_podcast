# OpenAI-compatible streaming endpoint used by the chat (role-play) layer.
# The codex CLI handles research; chat uses this endpoint directly so that
# the front-end can receive token-level delta SSE events.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai-hub.com/v1
OPENAI_CHAT_MODEL=gpt-4.1
